diff --git a/src/LibProsperoPkg/PKG/ProsperoNapsLayout.cs b/src/LibProsperoPkg/PKG/ProsperoNapsLayout.cs
index bbd909b..4c1f513 100644
--- a/src/LibProsperoPkg/PKG/ProsperoNapsLayout.cs
+++ b/src/LibProsperoPkg/PKG/ProsperoNapsLayout.cs
@@ -482,6 +482,20 @@ public static class ProsperoNapsLayout
         // The fidx count is package-dependent (padding/metadata pseudo-entries), so derive it from the exact
         // blob length rather than assuming NumFiles+1 (which only holds for some packages, e.g. DebugSettings).
         int fidxCount = DeriveFidxEntryCount(counts, blob.Length);
+        // Six or twelve alignment bytes can masquerade as additional fidx
+        // entries. Recognize the builder's standard trailer before using the
+        // length heuristic, which remains necessary for other package shapes.
+        NapsSectionMap standard = SectionMap(counts);
+        long padding = blob.Length - standard.TotalSize;
+        long trailer = standard.UncompressedOffsetStartByFileIdx.Offset
+            + standard.UncompressedOffsetStartByFileIdx.Size - FileOffsetStride;
+        if (padding is >= 0 and < DefaultAlignment && trailer >= 0 &&
+            blob.Slice((int)trailer, FileOffsetStride).SequenceEqual(new byte[] { 1, 0, 0, 5, 6, 7 }))
+        {
+            bool zeroPadding = true;
+            foreach (byte b in blob[(int)standard.TotalSize..]) zeroPadding &= b == 0;
+            if (zeroPadding) fidxCount = counts.NumFileOffsetEntries;
+        }
         return Parse(blob, counts, fidxCount);
     }
 
