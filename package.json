{
  "name": "atmosphere-ps5-source",
  "version": "0.4.1",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build:icon": "node tools/render-icon.mjs",
    "build": "npm run catalog:check && tsc -b && vite build && .venv/bin/python tools/embed.py",
    "typecheck": "tsc -b",
    "test": "node --test tests/*.test.mjs",
    "release:check": "node tools/release-check.mjs",
    "release:package": "node tools/package-release.mjs",
    "format": "prettier --write src vite.config.ts package.json",
    "catalog:metadata": ".venv/bin/python tools/catalog.py metadata",
    "catalog:verify": ".venv/bin/python tools/catalog.py verify",
    "catalog:build": ".venv/bin/python tools/catalog.py build",
    "catalog:check": ".venv/bin/python tools/catalog.py check",
    "test:catalog": ".venv/bin/python -m unittest discover -s tests -p catalog_test.py",
    "catalog:publish": ".venv/bin/python tools/publish_catalog.py"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.9.9",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
